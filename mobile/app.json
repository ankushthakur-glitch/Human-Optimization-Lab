{
  "expo": {
    "name": "Inlay Health",
    "slug": "human-optimization-patient",
    "scheme": "hol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.humanoptimizationlab.patient",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.humanoptimizationlab.patient",
      "adaptiveIcon": {
        "backgroundColor": "#173E45",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Inlay Health",
      "themeColor": "#01837E",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Inlay Health uses Face ID to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Inlay Health uses your photos so you can log a meal from a picture.",
          "cameraPermission": "Inlay Health uses the camera so you can photograph a meal to log it."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-asset",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Inlay Health uses the microphone so you can speak your answers instead of typing.",
          "speechRecognitionPermission": "Inlay Health uses speech recognition to turn what you say into text. You review it before it is sent."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/app"
    }
  }
}
